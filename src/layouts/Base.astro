---
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/familjen-grotesk/wght.css';
import '../styles/global.css';
import { SITE } from '../config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description = SITE.description, type = 'website', pubDate, updatedDate, tags = [] } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const path = Astro.url.pathname;
const nav = [
  { label: 'Articles', href: url('/articles/') },
  { label: 'Topics', href: url('/topics/') },
  { label: 'About', href: url('/about/') },
];
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} feed`} href={url('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script is:inline>
      // Apply the saved or system theme before first paint so the page never flashes.
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{SITE.title}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="tools">
          <button type="button" class="icon-button" id="open-search" aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span>Search</span>
            <kbd>/</kbd>
          </button>
          <button type="button" class="icon-button theme-toggle" id="theme-toggle" aria-label="Dark theme" aria-pressed="false">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {SITE.author}</span>
        <div class="footer-links">
          <a href={url('/rss.xml')}>RSS feed</a>
          <a href={SITE.githubUrl}>Source on GitHub</a>
        </div>
      </div>
    </footer>

    <dialog class="search" id="search" aria-label="Search articles">
      <form class="search-form" method="dialog" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input class="search-input" id="search-input" type="search" placeholder="Search articles" autocomplete="off" spellcheck="false" aria-label="Search articles" />
        <button class="icon-button search-close" type="submit">Close</button>
      </form>
      <div class="search-results" id="search-results" aria-live="polite"></div>
    </dialog>

    <script>
      import { url } from '../lib/url';

      // ---- Theme toggle ----
      const toggle = document.getElementById('theme-toggle') as HTMLButtonElement;
      const syncToggle = () => {
        toggle.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      };
      syncToggle();
      toggle.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        syncToggle();
      });

      // ---- Search (powered by Pagefind, which is built together with the site) ----
      const dialog = document.getElementById('search') as HTMLDialogElement;
      const input = document.getElementById('search-input') as HTMLInputElement;
      const results = document.getElementById('search-results') as HTMLElement;
      const openButton = document.getElementById('open-search') as HTMLButtonElement;

      let pagefind: any = null;
      let pagefindFailed = false;
      let timer: number | undefined;
      let requestId = 0;

      async function loadPagefind() {
        if (pagefind || pagefindFailed) return pagefind;
        try {
          pagefind = await import(/* @vite-ignore */ url('/pagefind/pagefind.js'));
        } catch {
          pagefindFailed = true;
        }
        return pagefind;
      }

      function status(html: string) {
        results.innerHTML = `<p class="search-status">${html}</p>`;
      }

      function withBase(path: string) {
        const base = url('/').replace(/\/$/, '');
        return path.startsWith(base + '/') ? path : base + path;
      }

      async function runSearch(query: string) {
        const id = ++requestId;
        const q = query.trim();
        if (!q) return status('Type a word or phrase to search every article.');

        const pf = await loadPagefind();
        if (id !== requestId) return;
        if (!pf) {
          return status(
            'Search is created when the site is built. Run <code>npm run build</code> then <code>npm run preview</code> to try it locally.',
          );
        }

        const found = await pf.search(q);
        const hits = await Promise.all(found.results.slice(0, 8).map((r: any) => r.data()));
        if (id !== requestId) return;

        if (!hits.length) {
          const safe = q.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
          return status(`No articles match <code>${safe}</code>. Try a shorter or different word.`);
        }

        results.replaceChildren(
          ...hits.map((hit: any) => {
            const a = document.createElement('a');
            a.className = 'search-hit';
            a.href = withBase(hit.url);
            const t = document.createElement('span');
            t.className = 'search-hit-title';
            t.textContent = hit.meta?.title ?? hit.url;
            const e = document.createElement('span');
            e.className = 'search-hit-excerpt';
            e.innerHTML = hit.excerpt; // Pagefind escapes the text and only adds <mark> tags
            a.append(t, e);
            return a;
          }),
        );
      }

      function openSearch() {
        if (!dialog.open) dialog.showModal();
        input.focus();
        input.select();
        if (!input.value) status('Type a word or phrase to search every article.');
        loadPagefind();
      }

      openButton.addEventListener('click', openSearch);
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => runSearch(input.value), 120);
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      document.addEventListener('keydown', (event) => {
        const el = event.target as HTMLElement | null;
        const typing = el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
        const shortcut = (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey && !event.altKey) ||
          ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k');
        if (shortcut) {
          event.preventDefault();
          openSearch();
        }
      });
    </script>
  </body>
</html>
