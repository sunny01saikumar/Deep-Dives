---
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/familjen-grotesk/wght.css';
import '@fontsource-variable/noto-sans-telugu/wght.css';
import '@fontsource-variable/noto-serif-telugu/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import { SITE, type Lang, type LangFilter } from '../config';
import { byLang, getArticles, pickFront } from '../lib/articles';
import { pageLang, t } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Which language the menu and labels use, and which stories the ticker shows. */
  filter?: LangFilter;
  /** Set when the page's own text is in a language other than the menu's. */
  htmlLang?: Lang;
  /** Absolute address of a picture for link previews. */
  image?: string;
  imageAlt?: string;
  /** Hide the breaking ticker on pages where it would be noise. */
  ticker?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  pubDate,
  updatedDate,
  tags = [],
  filter = 'all',
  htmlLang,
  image,
  imageAlt,
  ticker = true,
} = Astro.props;

const lang = pageLang(filter);
const documentLang = htmlLang ?? lang;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const front = ticker ? pickFront(byLang(await getArticles(), filter)) : undefined;
---

<!doctype html>
<html lang={documentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} feed`} href={url('/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <script is:inline>
      // Apply the saved or system theme before first paint so the page never flashes.
      try {
        var saved = localStorage.getItem('theme');
        var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>

    <Header filter={filter} />
    {front && <Ticker items={front.tickerItems} breaking={front.tickerIsBreaking} lang={lang} />}

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {SITE.title}</span>
        <div class="footer-links">
          <a href={url('/articles/')}>{t(lang, 'latest')}</a>
          <a href={url('/topics/')}>{t(lang, 'topics')}</a>
          <a href={url('/about/')}>{t(lang, 'about')}</a>
          <a href={url('/rss.xml')}>{t(lang, 'rss')}</a>
          <a href={SITE.githubUrl}>{t(lang, 'source')}</a>
        </div>
      </div>
    </footer>

    <dialog
      class="search"
      id="search"
      aria-label={t(lang, 'search')}
      data-msg-empty={lang === 'te' ? 'ఏదైనా పదం లేదా వాక్యం టైప్ చేసి అన్ని వార్తల్లో వెతకండి.' : 'Type a word or phrase to search every story.'}
      data-msg-none={lang === 'te' ? 'దీనికి సరిపోయే వార్తలు లేవు:' : 'No stories match'}
      data-msg-none-hint={lang === 'te' ? 'చిన్న లేదా వేరే పదం ప్రయత్నించండి.' : 'Try a shorter or different word.'}
      data-msg-build="Search is created when the site is built. Run <code>npm run build</code> then <code>npm run preview</code> to try it locally."
    >
      <form class="search-form" method="dialog" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input class="search-input" id="search-input" type="search" placeholder={t(lang, 'search')} autocomplete="off" spellcheck="false" aria-label={t(lang, 'search')} />
        <button class="icon-button search-close" type="submit">{lang === 'te' ? 'మూసివేయి' : 'Close'}</button>
      </form>
      <div class="search-results" id="search-results" aria-live="polite"></div>
    </dialog>

    <script>
      import { url } from '../lib/url';

      // ---- Theme toggle ----
      const toggle = document.getElementById('theme-toggle') as HTMLButtonElement;
      const syncToggle = () => {
        toggle.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      };
      syncToggle();
      toggle.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        syncToggle();
      });

      // ---- Search (powered by Pagefind, which is built together with the site) ----
      const dialog = document.getElementById('search') as HTMLDialogElement;
      const input = document.getElementById('search-input') as HTMLInputElement;
      const results = document.getElementById('search-results') as HTMLElement;
      const openButton = document.getElementById('open-search') as HTMLButtonElement;
      const msg = dialog.dataset;

      let pagefind: any = null;
      let pagefindFailed = false;
      let timer: number | undefined;
      let requestId = 0;

      async function loadPagefind() {
        if (pagefind || pagefindFailed) return pagefind;
        try {
          pagefind = await import(/* @vite-ignore */ url('/pagefind/pagefind.js'));
        } catch {
          pagefindFailed = true;
        }
        return pagefind;
      }

      function status(html: string) {
        results.innerHTML = `<p class="search-status">${html}</p>`;
      }

      function withBase(path: string) {
        const base = url('/').replace(/\/$/, '');
        return path.startsWith(base + '/') ? path : base + path;
      }

      const escapeHtml = (value: string) =>
        value.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

      async function runSearch(query: string) {
        const id = ++requestId;
        const q = query.trim();
        if (!q) return status(msg.msgEmpty ?? '');

        const pf = await loadPagefind();
        if (id !== requestId) return;
        if (!pf) return status(msg.msgBuild ?? '');

        const found = await pf.search(q);
        const hits = await Promise.all(found.results.slice(0, 8).map((r: any) => r.data()));
        if (id !== requestId) return;

        if (!hits.length) {
          return status(`${msg.msgNone} <code>${escapeHtml(q)}</code>. ${msg.msgNoneHint}`);
        }

        results.replaceChildren(
          ...hits.map((hit: any) => {
            const a = document.createElement('a');
            a.className = 'search-hit';
            a.href = withBase(hit.url);
            const t = document.createElement('span');
            t.className = 'search-hit-title';
            t.textContent = hit.meta?.title ?? hit.url;
            const e = document.createElement('span');
            e.className = 'search-hit-excerpt';
            e.innerHTML = hit.excerpt; // Pagefind escapes the text and only adds <mark> tags
            a.append(t, e);
            return a;
          }),
        );
      }

      function openSearch() {
        if (!dialog.open) dialog.showModal();
        input.focus();
        input.select();
        if (!input.value) status(msg.msgEmpty ?? '');
        loadPagefind();
      }

      openButton.addEventListener('click', openSearch);
      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => runSearch(input.value), 120);
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      document.addEventListener('keydown', (event) => {
        const el = event.target as HTMLElement | null;
        const typing = el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
        const shortcut =
          (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey && !event.altKey) ||
          ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k');
        if (shortcut) {
          event.preventDefault();
          openSearch();
        }
      });
    </script>
  </body>
</html>
