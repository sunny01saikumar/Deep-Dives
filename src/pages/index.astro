---
import Base from '../layouts/Base.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { SITE } from '../config';
import { formatDate, getArticles, minutesToRead, tagSlug } from '../lib/articles';
import { url } from '../lib/url';

const articles = await getArticles();
const [latest, ...rest] = articles;
const more = rest.slice(0, 6);
---

<Base>
  <div class="wrap">
    {latest ? (
      <>
        <section class="lead">
          <h1 class="lead-note">{SITE.tagline}</h1>
          <h2 class="lead-title">
            <a href={url(`/articles/${latest.id}/`)}>{latest.data.title}</a>
          </h2>
          <p class="lead-dek">{latest.data.description}</p>
          <div class="meta">
            <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time>
            <span>{minutesToRead(latest)} min read</span>
            {latest.data.tags.length > 0 && (
              <ul class="tags" aria-label="Topics">
                {latest.data.tags.map((tag) => (
                  <li><a class="tag" href={url(`/topics/${tagSlug(tag)}/`)}>{tag}</a></li>
                ))}
              </ul>
            )}
          </div>
        </section>

        {more.length > 0 && (
          <section aria-labelledby="more-heading">
            <div class="section-head">
              <h2 class="section-title" id="more-heading">More articles</h2>
              {rest.length > more.length && <a href={url('/articles/')}>See all {articles.length} articles</a>}
            </div>
            <ul class="entries">
              {more.map((article) => <ArticleRow article={article} level="h3" />)}
            </ul>
          </section>
        )}
      </>
    ) : (
      <section class="lead">
        <h1 class="lead-title">{SITE.title}</h1>
        <div class="empty">
          <p>
            No articles yet. Add a Markdown file to <code>src/content/articles/</code> or run
            <code>npm run new</code> to start one.
          </p>
        </div>
      </section>
    )}
  </div>
</Base>
