---
import Base from '../layouts/Base.astro';
import { SECTIONS, SITE } from '../config';
import { url } from '../lib/url';
---

<Base title="About" description={`About ${SITE.title}.`}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-title">About</h1>
    </header>
    <div class="prose" style="max-width: var(--measure)">
      <p>
        {SITE.title} publishes news, explainers and long reads in English and Telugu. Stories are grouped into
        {SECTIONS.map((s) => s.en.toLowerCase()).join(', ')}.
      </p>
      <p>
        Every story shows when it was published and, if it changed, when it was updated. Times are in India Standard
        Time. Longer reads show how many minutes are left as you scroll.
      </p>
      <p>
        Follow along with the <a href={url('/rss.xml')}>RSS feed</a>, or read the
        <a href={SITE.githubUrl}>source on GitHub</a>. Press <code>/</code> on any page to search every story.
      </p>
      <p lang="te">
        {SITE.title} ఇంగ్లీష్ మరియు తెలుగులో వార్తలు, వివరణాత్మక కథనాలు మరియు సుదీర్ఘ రచనలను ప్రచురిస్తుంది.
      </p>
    </div>
  </div>
</Base>
