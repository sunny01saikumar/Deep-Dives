---
import Base from '../../layouts/Base.astro';
import { getArticles, groupByTag } from '../../lib/articles';
import { url } from '../../lib/url';

const tags = groupByTag(await getArticles());
---

<Base title="Topics" description="Browse Deep Dives stories by topic.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-title">Topics</h1>
      <p class="page-intro">Pick a topic to see every story about it.</p>
    </header>

    {tags.length === 0 ? (
      <div class="empty">
        <p>No topics yet. Add <code>tags: ["example"]</code> to a story to create one.</p>
      </div>
    ) : (
      <ul class="topic-list">
        {tags.map((tag) => (
          <li>
            <a href={url(`/topics/${tag.slug}/`)}>
              {tag.name}
              <span>{tag.articles.length} {tag.articles.length === 1 ? 'story' : 'stories'}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
