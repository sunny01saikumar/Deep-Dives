---
import { articleHref, formatDateTime, minutesToRead, tagSlug, type Article } from '../lib/articles';
import { sectionLabel, t } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  article: Article;
  /** Use 'h3' when the list sits under an h2 section title. */
  level?: 'h2' | 'h3';
}

const { article, level = 'h2' } = Astro.props;
const { title, description, pubDate, tags, draft, lang, section } = article.data;
const Heading = level;
---

<li class="entry" lang={lang}>
  <time class="entry-date" datetime={pubDate.toISOString()}>{formatDateTime(pubDate, lang, 'short')}</time>
  <div>
    <Heading class="entry-title">
      <a href={url(articleHref(article))}>{title}</a>
    </Heading>
    <p class="entry-dek">{description}</p>
    <div class="meta">
      <span>{sectionLabel(section, lang)}</span>
      <span>{minutesToRead(article)} {t(lang, 'minRead')}</span>
      {draft && <span>Draft, only visible while writing</span>}
      {tags.length > 0 && (
        <ul class="tags" aria-label={t(lang, 'topics')}>
          {tags.map((tag) => (
            <li><a class="tag" href={url(`/topics/${tagSlug(tag)}/`)}>{tag}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</li>
