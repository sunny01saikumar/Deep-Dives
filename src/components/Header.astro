---
import { LANGUAGES, SECTIONS, SITE, type LangFilter } from '../config';
import { filterHref, pageLang, t } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  filter: LangFilter;
}

const { filter } = Astro.props;
const lang = pageLang(filter);
const path = Astro.url.pathname;

const home = filterHref(filter, '/');
const items = [
  { label: t(lang, 'home'), href: home, exact: true },
  ...SECTIONS.map((s) => ({ label: s[lang], href: filterHref(filter, `/section/${s.slug}/`), exact: false })),
  { label: t(lang, 'videos'), href: url('/videos/'), exact: false },
  { label: t(lang, 'photos'), href: url('/photos/'), exact: false },
];

const languageLinks: { label: string; href: string; active: boolean; lang?: string }[] = [
  { label: t(lang, 'allLanguages'), href: url('/'), active: filter === 'all' },
  ...LANGUAGES.map((l) => ({ label: l.label, href: url(`/${l.code}/`), active: filter === l.code, lang: l.code })),
];
---

<header class="site-header">
  <div class="wrap utility">
    <nav class="lang-switch" aria-label={t(lang, 'language')}>
      {languageLinks.map((l) => (
        <a href={l.href} lang={l.lang} aria-current={l.active ? 'true' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="tools">
      <button type="button" class="icon-button" id="open-search" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span>{t(lang, 'search')}</span>
        <kbd>/</kbd>
      </button>
      <button type="button" class="icon-button theme-toggle" id="theme-toggle" aria-label="Dark theme" aria-pressed="false">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      </button>
    </div>
  </div>

  <div class="wrap masthead">
    <a class="brand" href={home}>{SITE.title}</a>
  </div>

  <nav class="section-nav" aria-label={t(lang, 'menu')}>
    <div class="wrap">
      <ul>
        {items.map((item) => {
          const current = item.exact ? path === item.href : path.startsWith(item.href);
          return (
            <li><a href={item.href} aria-current={current ? 'page' : undefined}>{item.label}</a></li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>
