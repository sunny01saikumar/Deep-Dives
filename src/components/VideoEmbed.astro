---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../lib/i18n';
import type { Lang } from '../config';

interface Props {
  /** Full embed address, from lib/video.ts */
  src: string;
  title: string;
  poster?: ImageMetadata;
  lang: Lang;
}

const { src, title, poster, lang } = Astro.props;
---

<!-- The player only loads from YouTube after the viewer presses play, so the page stays fast and private. -->
<div class="video" data-video-src={src} data-video-title={title}>
  <button class="video-play" type="button" aria-label={`${t(lang, 'watch')}: ${title}`}>
    {poster && <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 64rem) 48rem, 100vw" loading="lazy" format="webp" />}
    <span class="video-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </span>
  </button>
</div>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.video-play');
    if (!button) return;
    const box = button.closest<HTMLElement>('.video');
    if (!box?.dataset.videoSrc) return;
    const iframe = document.createElement('iframe');
    const joiner = box.dataset.videoSrc.includes('?') ? '&' : '?';
    iframe.src = `${box.dataset.videoSrc}${joiner}autoplay=1&rel=0`;
    iframe.title = box.dataset.videoTitle ?? 'Video';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    box.replaceChildren(iframe);
    iframe.focus();
  });
</script>
